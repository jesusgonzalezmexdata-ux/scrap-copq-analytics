{
  "title": "Scrap and cost of poor quality",
  "emoji": "🔧",
  "colorFrom": "red",
  "colorTo": "gray",
  "entrypoint": "streamlit_app.py",
  "requirements": [
    "statsmodels",
    "matplotlib",
    "plotly",
    "openpyxl"
  ],
  "include": [
    "streamlit_app.py",
    "scrap_copq",
    "data/processed"
  ],
  "short_description": "Scrap cost and levers; try it with your plant's Excel",
  "summary": "Synthetic auto-parts plant, or upload your own Excel: the diagnosis runs in your browser and your data never leave it.",
  "repo": "scrap-copq-analytics",
  "license": "mit",
  "streamlitConfig": {
    "theme.base": "light",
    "theme.primaryColor": "#0E0F11",
    "theme.backgroundColor": "#FFFFFF",
    "theme.secondaryBackgroundColor": "#F6F7F5",
    "theme.textColor": "#0E0F11",
    "theme.redColor": "#D7261E",
    "theme.greenColor": "#1F7A3D",
    "theme.yellowColor": "#FFD21F",
    "theme.grayColor": "#4A4E54",
    "theme.linkColor": "#0E0F11",
    "theme.borderColor": "#C9CDD1",
    "theme.showWidgetBorder": true,
    "theme.baseRadius": "4px",
    "theme.buttonRadius": "6px",
    "theme.dataframeHeaderBackgroundColor": "#F6F7F5"
  }
}
